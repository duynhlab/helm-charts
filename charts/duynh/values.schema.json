{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "enabled": {
          "type": "boolean"
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "port"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 15
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "targetPort": {
                "type": ["integer", "string"]
              },
              "protocol": {
                "type": "string",
                "enum": ["TCP", "UDP", "SCTP"]
              }
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["integer", "string", "null"]
        },
        "maxUnavailable": {
          "type": ["integer", "string"]
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "parentRefs", "rules"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "sloth": {
      "type": "object",
      "required": ["enabled", "annotations", "service", "labels", "slos"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "service": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slos": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "namespace": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "minLength": 1
              },
              "slos": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "containerName": {
      "type": "string"
    },
    "extraSelectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraPorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "containerPort"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": ["TCP", "UDP", "SCTP"]
          }
        }
      }
    },
    "initContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": ["object", "string"]
      }
    }
  },
  "required": [
    "replicaCount",
    "image",
    "containerPort",
    "service",
    "autoscaling",
    "pdb",
    "httpRoute",
    "sloth"
  ]
}
